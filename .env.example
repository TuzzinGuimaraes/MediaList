COMPOSE_PROJECT_NAME=medialist

BACKEND_PORT=5000
FRONTEND_PORT=3005
POSTGRES_PORT=5433
# FRONTEND_PORT é a do web (serviço frontend do compose, nginx). O web chama a API no
# mesmo domínio (/api, que o nginx encaminha ao backend), sem variável de build.
# O PostgreSQL só escuta em 127.0.0.1. Backend e web escutam em todas as
# interfaces (o celular acessa o :5000 pela rede local); use 127.0.0.1 para
# restringir à máquina.
BACKEND_BIND=0.0.0.0
FRONTEND_BIND=0.0.0.0

# development | production. Em production o app recusa iniciar se
# JWT_SECRET_KEY estiver ausente ou com o valor default deste arquivo, ou se
# faltar DATABASE_URL e DB_PASSWORD estiver ausente ou com o default; o CORS
# fica desligado (mesmo domínio).
APP_ENV=development
# Só em development: origens extras liberadas no CORS, separadas por vírgula,
# além de localhost/127.0.0.1 em qualquer porta. Ex.: http://192.168.0.10:3005
CORS_ORIGINS=

DB_NAME=medialist_db
# Dono do banco: cria o schema e roda as migrações (serviço `migrate`).
DB_OWNER_USER=medialist_owner
DB_OWNER_PASSWORD=medialist-owner-dev
# Usuário da aplicação: só SELECT/INSERT/UPDATE/DELETE. Criado pelo
# docker/postgres-init no primeiro start com volume vazio.
DB_USER=media_app_user
DB_PASSWORD=MediaList@2025!Secure
# Produção (Neon, ADR-0013): URLs prontas, usadas como vêm (com sslmode=require).
# Definidas, valem no lugar das DB_*. DATABASE_URL é o usuário da aplicação (pooler);
# DATABASE_OWNER_URL é o dono (conexão direta), para migrações e backup.
# Deixe vazias no dev e no compose.
# Ex.: postgresql://media_app_user:SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/medialist_db?sslmode=require
DATABASE_URL=
DATABASE_OWNER_URL=

JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ACCESS_TOKEN_DAYS=1
# Validade do refresh token rotativo do app mobile (ADR-0006)
JWT_REFRESH_TOKEN_DAYS=30

RAWG_API_KEY=
ANILIST_API_URL=https://graphql.anilist.co
RAWG_API_URL=https://api.rawg.io/api
# Integração MyAnimeList (ADR-0015): Client ID grátis em myanimelist.net/apiconfig. Sem ela, só o XML.
MAL_CLIENT_ID=
# Integração com a Steam (ADR-0015); vazia, a Steam aparece indisponível no Perfil
STEAM_API_KEY=

# Push das Notícias pelo Expo (ADR-0011): só se o projeto Expo exigir push seguro; vazio, envia sem.
EXPO_ACCESS_TOKEN=
