COMPOSE_PROJECT_NAME=medialist

BACKEND_PORT=5000
FRONTEND_PORT=3005
POSTGRES_PORT=5433
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
# PostgreSQL, MongoDB e mongo-express só escutam em 127.0.0.1. Backend e frontend
# escutam em todas as interfaces (o celular acessa o :5000 pela rede local);
# use 127.0.0.1 para restringir à máquina.
BACKEND_BIND=0.0.0.0
FRONTEND_BIND=0.0.0.0

# development | production. Em production o app recusa iniciar se
# JWT_SECRET_KEY, DB_PASSWORD ou a senha do Mongo estiverem ausentes ou com
# os valores default deste arquivo, e o CORS fica desligado (mesmo domínio).
APP_ENV=development
# Só em development: origens extras liberadas no CORS, separadas por vírgula,
# além de localhost/127.0.0.1 em qualquer porta. Ex.: http://192.168.0.10:3005
CORS_ORIGINS=

DB_NAME=medialist_db
# Dono do banco: cria o schema e roda as migrações (serviço `migrate`).
DB_OWNER_USER=medialist_owner
DB_OWNER_PASSWORD=medialist-owner-dev
# Usuário da aplicação: só SELECT/INSERT/UPDATE/DELETE. Criado pelo
# docker/postgres-init no primeiro start com volume vazio.
DB_USER=media_app_user
DB_PASSWORD=MediaList@2025!Secure

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=senha123
MONGO_DB_NAME=medialist_updates_db
# Usuário da aplicação (readWrite só no MONGO_DB_NAME); o backend conecta com
# ele, não com o root. Volume existente: rode `make mongo-app-user`.
# A senha entra na URI: evite @ : / ou use percent-encoding.
MONGO_APP_USER=medialist_app
MONGO_APP_PASSWORD=medialist-app-dev

JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ACCESS_TOKEN_DAYS=1
# Validade do refresh token rotativo do app mobile (ADR-0006)
JWT_REFRESH_TOKEN_DAYS=30

REACT_APP_API_URL=/api
RAWG_API_KEY=
ANILIST_API_URL=https://graphql.anilist.co
RAWG_API_URL=https://api.rawg.io/api
