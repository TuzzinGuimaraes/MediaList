{
  "components": {
    "schemas": {
      "CodigoErro": {
        "description": "Código estável do erro, para o cliente decidir sem ler a mensagem.",
        "enum": [
          "dados_invalidos",
          "requisicao_invalida",
          "nao_autenticado",
          "token_expirado",
          "token_invalido",
          "token_revogado",
          "sessao_invalida",
          "acesso_negado",
          "nao_encontrado",
          "metodo_nao_permitido",
          "conflito",
          "indisponivel",
          "erro_interno"
        ],
        "title": "CodigoErro",
        "type": "string"
      },
      "ConsultaGeneros": {
        "properties": {
          "tipo": {
            "anyOf": [
              {
                "enum": [
                  "anime",
                  "manga",
                  "jogo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tipo"
          }
        },
        "title": "ConsultaGeneros",
        "type": "object"
      },
      "Erro": {
        "description": "Envelope de todo erro da API.",
        "properties": {
          "codigo": {
            "$ref": "#/components/schemas/CodigoErro"
          },
          "detalhes": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Motivo por campo, nos erros de validação",
            "title": "Detalhes"
          },
          "erro": {
            "description": "Mensagem para a tela, em português",
            "title": "Erro",
            "type": "string"
          }
        },
        "required": [
          "erro",
          "codigo"
        ],
        "title": "Erro",
        "type": "object"
      },
      "Genero": {
        "properties": {
          "aplicavel_a": {
            "items": {
              "enum": [
                "anime",
                "manga",
                "jogo"
              ],
              "type": "string"
            },
            "title": "Aplicavel A",
            "type": "array"
          },
          "id_genero": {
            "title": "Id Genero",
            "type": "string"
          },
          "nome_genero": {
            "title": "Nome Genero",
            "type": "string"
          }
        },
        "required": [
          "id_genero",
          "nome_genero",
          "aplicavel_a"
        ],
        "title": "Genero",
        "type": "object"
      },
      "RespostaGeneros": {
        "properties": {
          "generos": {
            "items": {
              "$ref": "#/components/schemas/Genero"
            },
            "title": "Generos",
            "type": "array"
          }
        },
        "required": [
          "generos"
        ],
        "title": "RespostaGeneros",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "MediaList API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/generos": {
      "get": {
        "description": "",
        "operationId": "get__api_generos",
        "parameters": [
          {
            "description": "",
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "anime",
                    "manga",
                    "jogo"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Tipo"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaGeneros"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Listar gêneros; `?tipo=` só os que se aplicam ao Tipo de mídia.",
        "tags": [
          "utils"
        ]
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "utils"
    }
  ]
}
