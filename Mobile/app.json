{
  "expo": {
    "name": "MediaList",
    "slug": "medialist",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "medialist",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0E10",
    "android": {
      "package": "dev.medialist.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0E0E10"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#9B1B30"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8e4c013-6733-4d93-a985-66090f3c8a0b"
      }
    },
    "owner": "arturaguimaraes",
    "updates": {
      "url": "https://u.expo.dev/a8e4c013-6733-4d93-a985-66090f3c8a0b"
    },
    "ios": {}
  }
}
