{
  "expo": {
    "name": "MediaList",
    "slug": "medialist",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medialist",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1622",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1622"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1622"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
